# ================================================================
# CRYPTO FRAUD & VASP INTELLIGENCE - ENVIRONMENT CONFIGURATION
# Copy this file to .env before starting the application
# DO NOT commit real API keys or secrets to GitHub!
# ================================================================

# Backend Configuration (Spring Boot)
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Mock Mode (Set to true to use local data/sample-*.json files without external API dependencies)
USE_MOCK_DATA=true

# Blockchain Data (Ethereum via Etherscan API - Free tier)
# Sign up at https://etherscan.io/apis to obtain a free public API key
ETHERSCAN_API_KEY=your_etherscan_api_key_here
ETHERSCAN_BASE_URL=https://api.etherscan.io/api

# AI Explanation Service (Optional - System uses rule-based fallback if disabled/empty)
AI_API_KEY=your_free_tier_ai_key_here
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash

# Frontend Configuration (React + Vite)
VITE_PORT=5173
VITE_BACKEND_API_URL=http://localhost:8080/api
